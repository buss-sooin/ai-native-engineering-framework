{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collaboration-routing:project-routing-profile:1.4",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.4"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "effects": {
            "type": "array",
            "items": {
              "enum": [
                "READ_ONLY",
                "ARTIFACT_WRITE",
                "REPOSITORY_MUTATION",
                "COMMAND_EXECUTION",
                "RUNTIME_OBSERVATION",
                "RUNTIME_MUTATION",
                "EXTERNAL_SIDE_EFFECT"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "actor": {
            "enum": [
              "AI",
              "HUMAN"
            ]
          },
          "deterministic": {
            "type": "boolean"
          },
          "authority_required": {
            "type": "boolean"
          },
          "preferred_surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "human_handoff": {
            "type": "object",
            "properties": {
              "goal": {
                "type": "string",
                "minLength": 12
              },
              "observation": {
                "type": "string",
                "minLength": 12
              },
              "decision": {
                "type": "string",
                "minLength": 12
              },
              "expected_interpretation": {
                "type": "string",
                "minLength": 12
              }
            },
            "required": [
              "goal",
              "observation",
              "decision",
              "expected_interpretation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "capabilities",
          "effects",
          "actor",
          "deterministic",
          "authority_required",
          "preferred_surfaces",
          "human_handoff"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "trusted_human_responsibilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "human_necessity_basis": {
            "enum": [
              "HUMAN_AUTHORITY_REQUIRED",
              "DIRECT_HUMAN_OBSERVATION_OBJECTIVE",
              "HUMAN_RISK_CONTROL_REQUIRED",
              "HUMAN_LEARNING_OBJECTIVE",
              "HUMAN_EXECUTION_SIMPLER_OR_SAFER",
              "NO_SUITABLE_AUTHORIZED_AI_SURFACE"
            ]
          },
          "return_responsibility_kinds": {
            "type": "array",
            "items": {
              "enum": [
                "DECISION_OR_APPROVAL",
                "RISK_CONTROL_DECISION",
                "BLAST_RADIUS_CONTROL",
                "DIRECT_OBSERVATION",
                "LEARNING_OUTCOME",
                "DIRECT_ENGINEERING_RESULT",
                "ACK_ONLY",
                "RAW_OUTPUT_ONLY"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "action_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "human_role": {
            "enum": [
              "AUTHORITY_DECISION",
              "RISK_CONTROL",
              "DIRECT_OBSERVER",
              "LEARNER",
              "DIRECT_ENGINEER",
              "EXECUTION_ONLY_WHEN_NO_AI_SURFACE"
            ]
          },
          "required_session_role": {
            "type": "string",
            "minLength": 1
          },
          "required_request_owners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "request_field": {
                  "enum": [
                    "decision_owner",
                    "verification_owner"
                  ]
                },
                "required_owner": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "request_field",
                "required_owner"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "human_necessity_basis",
          "return_responsibility_kinds",
          "action_kinds",
          "human_role",
          "required_session_role",
          "required_request_owners"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "enum": [
              "AI",
              "HUMAN"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "available": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "KNOWN"
                    ]
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "state",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "UNKNOWN"
                    ]
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "NOT_REQUIRED"
                    ]
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              }
            ]
          },
          "model_recommendation": {
            "type": "string",
            "minLength": 1
          },
          "reasoning_recommendation": {
            "type": "string",
            "minLength": 1
          },
          "supported_effects": {
            "type": "array",
            "items": {
              "enum": [
                "READ_ONLY",
                "ARTIFACT_WRITE",
                "REPOSITORY_MUTATION",
                "COMMAND_EXECUTION",
                "RUNTIME_OBSERVATION",
                "RUNTIME_MUTATION",
                "EXTERNAL_SIDE_EFFECT"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "label",
          "actor",
          "capabilities",
          "available",
          "model_recommendation",
          "reasoning_recommendation",
          "supported_effects"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "operational_interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "compatible_surface_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "capability_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "display_name",
          "compatible_surface_ids",
          "capability_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "project",
    "actions",
    "trusted_human_responsibilities",
    "surfaces",
    "operational_interfaces"
  ],
  "additionalProperties": false
}
